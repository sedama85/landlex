# Copy to .env (never share/upload real API secrets)
# Register API access at https://open.law.go.kr/
LAW_OC=

# Free option: get a Gemini key at https://aistudio.google.com/apikey
# Choose gemini; set OPENAI_API_KEY blank if you do not want paid calls.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Alternative: AI_PROVIDER=ollama; OLLAMA_MODEL=qwen3.5:4b
# Ollama runs locally on port 11434 and requires a downloaded model.
# Optional paid OpenAI API:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# REQUIRED for document administration; use a long unpredictable value
ADMIN_TOKEN=

# SQLite file, relative to project directory
DATABASE_PATH=data/landlaw.db

# Upload limit on local server in megabytes, maximum hard cap 512 MB
MAX_UPLOAD_MB=512

# Expanded interpretation search is enabled by default from the UI.
# The UI checkbox can turn it off for faster searches.
